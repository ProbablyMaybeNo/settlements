filters:
  and:
    - file.inFolder("Settlements/Rules System/Second Draft/Rule Cards")
    - type == "settlements-rule-card"
formulas:
  rule_card_meta: note.rule_id + " · " + note.category + " · " + note.entry_type
  rule_card_color: if(note.publication == "Deferred", "#7d8999", if(note.review_status == "Needs review", "#f3b65b", if(note.category == "Combat" || note.category == "Weapons" || note.category == "Weapon traits" || note.category == "Weapon keyword" || note.category == "Weapon design", "#ef8178", if(note.category == "Movement" || note.category == "Activation" || note.category == "Actions" || note.category == "Setup", "#66c7ed", if(note.category == "Terrain" || note.category == "Interaction" || note.category == "Devices", "#4dd5bc", if(note.category == "Morale" || note.category == "Casualties" || note.category == "Lasting injuries" || note.category == "Stealth", "#c09af0", if(note.entry_type == "Skill", "#b4d776", if(note.category == "Structures" || note.category == "Settlement" || note.category == "Equipment", "#e6c570", "#96aabd"))))))))
  placement_changed: note.planned_section != (if(note.book_chapter < 10, "0", "") + note.book_chapter.toString() + " · " + note.book_section)
properties:
  file.name:
    displayName: Rule / mechanic
  formula.rule_card_meta:
    displayName: ID · Category · Type
  formula.rule_card_color:
    displayName: Category colour
  formula.placement_changed:
    displayName: Placement changed
  note.rule_name:
    displayName: Rule
  note.rule_id:
    displayName: ID
  note.entry_type:
    displayName: Type
  note.book_section:
    displayName: Current chapter
  note.book_subsection:
    displayName: Current subsection
  note.summary:
    displayName: Description
  note.last_rule_update:
    displayName: Last updated
  note.publication:
    displayName: Scope
  note.review_status:
    displayName: Status
  note.credits:
    displayName: Credits
  note.materials:
    displayName: Materials
  note.power:
    displayName: Power
  note.review_notes:
    displayName: Review notes
  note.keywords:
    displayName: Linked weapon keywords
  note.status:
    displayName: Rule stage
  note.category:
    displayName: Category
  note.tags:
    displayName: Tags
  note.planned_section:
    displayName: Planned section
views:
  - type: table
    name: Rules table
    order:
      - file.name
      - last_rule_update
      - review_status
      - category
      - summary
      - tags
      - book_section
      - book_subsection
      - planned_section
      - entry_type
      - publication
      - status
      - review_notes
      - rule_id
    sort:
      - property: rule_id
        direction: ASC
    rowHeight: medium
    columnSize:
      file.name: 300
      note.last_rule_update: 135
      note.review_status: 140
      note.category: 130
      note.summary: 440
      note.tags: 250
      note.book_section: 200
      note.book_subsection: 230
      note.planned_section: 260
      note.review_notes: 350
  - type: cards
    name: All cards
    order:
      - rule_name
      - formula.rule_card_meta
      - summary
      - review_status
      - last_rule_update
      - tags
    sort:
      - property: rule_id
        direction: ASC
    cardSize: 330
    image: formula.rule_card_color
    imageAspectRatio: 0.025
  - type: kanban
    name: Review board
    groupBy:
      property: review_status
      direction: ASC
    order:
      - rule_name
      - formula.rule_card_meta
      - summary
      - tags
      - last_rule_update
      - publication
    sort:
      - property: rule_id
        direction: ASC
    columnWidth: 350
    image: formula.rule_card_color
    imageAspectRatio: 0.025
  - type: table
    name: By book section
    groupBy:
      property: book_section
      direction: ASC
    order:
      - file.name
      - last_rule_update
      - review_status
      - category
      - summary
      - tags
      - book_section
      - book_subsection
      - planned_section
      - entry_type
      - publication
      - status
      - review_notes
      - rule_id
    sort:
      - property: rule_id
        direction: ASC
    rowHeight: medium
    columnSize:
      file.name: 300
      note.last_rule_update: 135
      note.review_status: 140
      note.category: 130
      note.summary: 440
      note.tags: 250
      note.book_section: 200
      note.book_subsection: 230
      note.planned_section: 260
      note.review_notes: 350
  - type: cards
    name: Battle rules
    filters:
      and:
        - book_chapter == 4
        - publication == "Included"
    order:
      - rule_name
      - formula.rule_card_meta
      - summary
      - review_status
      - last_rule_update
      - tags
    sort:
      - property: rule_id
        direction: ASC
    cardSize: 330
    image: formula.rule_card_color
    imageAspectRatio: 0.025
  - type: cards
    name: Combat
    filters:
      and:
        - file.hasTag("combat")
        - publication == "Included"
    order:
      - rule_name
      - formula.rule_card_meta
      - summary
      - review_status
      - last_rule_update
      - tags
    sort:
      - property: rule_id
        direction: ASC
    cardSize: 330
    image: formula.rule_card_color
    imageAspectRatio: 0.025
  - type: cards
    name: To-hit bonuses
    filters:
      and:
        - file.hasTag("hit-plus")
        - publication == "Included"
    order:
      - rule_name
      - formula.rule_card_meta
      - summary
      - review_status
      - last_rule_update
      - tags
    sort:
      - property: rule_id
        direction: ASC
    cardSize: 330
    image: formula.rule_card_color
    imageAspectRatio: 0.025
  - type: cards
    name: Armour bonuses
    filters:
      and:
        - file.hasTag("armour-plus")
        - publication == "Included"
    order:
      - rule_name
      - formula.rule_card_meta
      - summary
      - review_status
      - last_rule_update
      - tags
    sort:
      - property: rule_id
        direction: ASC
    cardSize: 330
    image: formula.rule_card_color
    imageAspectRatio: 0.025
  - type: cards
    name: Weapons
    filters:
      or:
        - entry_type == "Weapon"
        - entry_type == "Weapon class"
    order:
      - rule_name
      - formula.rule_card_meta
      - summary
      - review_status
      - last_rule_update
      - tags
    sort:
      - property: rule_id
        direction: ASC
    cardSize: 330
    image: formula.rule_card_color
    imageAspectRatio: 0.025
  - type: cards
    name: Weapon keywords
    filters:
      or:
        - entry_type == "Weapon keyword"
    order:
      - rule_name
      - formula.rule_card_meta
      - summary
      - review_status
      - last_rule_update
      - tags
    sort:
      - property: rule_id
        direction: ASC
    cardSize: 330
    image: formula.rule_card_color
    imageAspectRatio: 0.025
  - type: cards
    name: Skills
    filters:
      or:
        - entry_type == "Skill"
    order:
      - rule_name
      - formula.rule_card_meta
      - summary
      - review_status
      - last_rule_update
      - tags
    sort:
      - property: rule_id
        direction: ASC
    cardSize: 330
    image: formula.rule_card_color
    imageAspectRatio: 0.025
  - type: cards
    name: Equipment and devices
    filters:
      or:
        - entry_type == "Armour"
        - entry_type == "Equipment"
        - entry_type == "Deployable"
    order:
      - rule_name
      - formula.rule_card_meta
      - summary
      - review_status
      - last_rule_update
      - tags
    sort:
      - property: rule_id
        direction: ASC
    cardSize: 330
    image: formula.rule_card_color
    imageAspectRatio: 0.025
  - type: cards
    name: Interactive terrain
    filters:
      or:
        - entry_type == "Interactive terrain"
    order:
      - rule_name
      - formula.rule_card_meta
      - summary
      - review_status
      - last_rule_update
      - tags
    sort:
      - property: rule_id
        direction: ASC
    cardSize: 330
    image: formula.rule_card_color
    imageAspectRatio: 0.025
  - type: cards
    name: Structures
    filters:
      or:
        - entry_type == "Structure"
    order:
      - rule_name
      - formula.rule_card_meta
      - summary
      - review_status
      - last_rule_update
      - tags
    sort:
      - property: rule_id
        direction: ASC
    cardSize: 330
    image: formula.rule_card_color
    imageAspectRatio: 0.025
  - type: table
    name: Needs review
    filters: review_status == "Needs review"
    order:
      - file.name
      - last_rule_update
      - review_status
      - category
      - summary
      - tags
      - book_section
      - book_subsection
      - planned_section
      - entry_type
      - publication
      - status
      - review_notes
      - rule_id
    sort:
      - property: rule_id
        direction: ASC
    rowHeight: medium
    columnSize:
      file.name: 300
      note.last_rule_update: 135
      note.review_status: 140
      note.category: 130
      note.summary: 440
      note.tags: 250
      note.book_section: 200
      note.book_subsection: 230
      note.planned_section: 260
      note.review_notes: 350
  - type: cards
    name: Deferred objective proposals
    filters: publication == "Deferred"
    order:
      - rule_name
      - formula.rule_card_meta
      - summary
      - review_status
      - last_rule_update
      - tags
    sort:
      - property: rule_id
        direction: ASC
    cardSize: 330
    image: formula.rule_card_color
    imageAspectRatio: 0.025
  - type: table
    name: Recently updated
    filters: note.last_rule_update != null && note.last_rule_update != ""
    order:
      - file.name
      - last_rule_update
      - review_status
      - category
      - summary
      - tags
      - book_section
      - book_subsection
      - planned_section
      - entry_type
      - publication
      - status
      - review_notes
      - rule_id
    sort:
      - property: last_rule_update
        direction: DESC
      - property: rule_id
        direction: ASC
    rowHeight: medium
    columnSize:
      file.name: 300
      note.last_rule_update: 135
      note.review_status: 140
      note.category: 130
      note.summary: 440
      note.tags: 250
      note.book_section: 200
      note.book_subsection: 230
      note.planned_section: 260
      note.review_notes: 350
