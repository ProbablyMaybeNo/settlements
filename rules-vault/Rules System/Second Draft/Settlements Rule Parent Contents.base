filters:
  and:
  - file.inFolder("Settlements/Rules System/Second Draft/Rule Cards")
  - type == "settlements-rule-card"
  - book_section == this.parent_family
  - rule_parent == this.parent_name
formulas:
  rule_card_meta: note.rule_id + " · " + note.category + " · " + note.entry_type
  rule_card_color: if(note.publication == "Deferred", "#7d8999", if(note.review_status == "Needs review", "#f3b65b", if(note.category == "Combat"
    || note.category == "Weapons" || note.category == "Weapon traits" || note.category == "Weapon keyword" || note.category == "Weapon design",
    "#ef8178", if(note.category == "Movement" || note.category == "Activation" || note.category == "Actions" || note.category == "Setup", "#66c7ed",
    if(note.category == "Terrain" || note.category == "Interaction" || note.category == "Devices", "#4dd5bc", if(note.category == "Morale" ||
    note.category == "Casualties" || note.category == "Lasting injuries" || note.category == "Stealth", "#c09af0", if(note.entry_type == "Skill",
    "#b4d776", if(note.category == "Structures" || note.category == "Settlement" || note.category == "Equipment", "#e6c570", "#96aabd"))))))))
properties:
  note.rule_parent:
    displayName: Type / Parent
  file.name:
    displayName: Rule / mechanic
  formula.rule_card_meta:
    displayName: ID · Category · Type
  formula.rule_card_color:
    displayName: Category colour
  formula.placement_changed:
    displayName: Placement changed
  note.rule_name:
    displayName: Rule
  note.rule_id:
    displayName: ID
  note.entry_type:
    displayName: Type
  note.book_section:
    displayName: Family / Current chapter
  note.book_subsection:
    displayName: Current subsection
  note.summary:
    displayName: Description
  note.last_rule_update:
    displayName: Last updated
  note.publication:
    displayName: Scope
  note.review_status:
    displayName: Review flag
  note.credits:
    displayName: Credits
  note.materials:
    displayName: Materials
  note.power:
    displayName: Power
  note.review_notes:
    displayName: Review notes
  note.keywords:
    displayName: Linked weapon keywords
  note.status:
    displayName: Status
  note.category:
    displayName: Category
  note.tags:
    displayName: Tags
  note.planned_section:
    displayName: Planned section
views:
- type: table
  name: Rules
  order:
  - file.name
  - note.status
  - note.summary
  - note.last_rule_update
  - note.tags
  - note.rule_parent
  sort:
  - property: note.rule_id
    direction: ASC
  rowHeight: medium
  columnSize:
    file.name: 300
    note.summary: 470
    note.status: 120
- type: cards
  name: Cards
  order:
  - note.rule_name
  - formula.rule_card_meta
  - note.summary
  - note.status
  - note.tags
  sort:
  - property: note.rule_id
    direction: ASC
  cardSize: 330
  image: formula.rule_card_color
  imageAspectRatio: 0.025
