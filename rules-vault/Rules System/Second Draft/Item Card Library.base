filters:
  and:
  - file.inFolder("Settlements/Rules System/Second Draft/Item Cards")
  - type == "settlements-item-card"
properties:
  note.rule_name:
    displayName: Name
  note.rule_id:
    displayName: ID
  note.card_kind:
    displayName: Card type
  note.catalogue:
    displayName: Catalogue
  note.status:
    displayName: Status
  note.summary:
    displayName: Description
  formula.item_link:
    displayName: Name
views:
- type: table
  name: All item cards
  order:
  - formula.item_link
  - note.rule_id
  - note.status
  - note.card_kind
  - note.catalogue
  - note.summary
  sort:
  - property: note.rule_id
    direction: ASC
  rowHeight: medium
  groupBy:
    property: note.card_kind
    direction: ASC
- type: table
  name: Weapon Cards
  order:
  - formula.item_link
  - note.rule_id
  - note.status
  - note.card_kind
  - note.catalogue
  - note.summary
  sort:
  - property: note.rule_id
    direction: ASC
  rowHeight: medium
  filters: card_kind == "Weapon"
- type: table
  name: Skill Cards
  order:
  - formula.item_link
  - note.rule_id
  - note.status
  - note.card_kind
  - note.catalogue
  - note.summary
  sort:
  - property: note.rule_id
    direction: ASC
  rowHeight: medium
  filters: card_kind == "Skill"
- type: table
  name: Equipment Cards
  order:
  - formula.item_link
  - note.rule_id
  - note.status
  - note.card_kind
  - note.catalogue
  - note.summary
