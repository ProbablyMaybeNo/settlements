views:
  - type: table
    name: All
    rowHeight: medium
    filters:
      and:
        - type == "structures"
    order:
      - file.name
      - class
      - size
      - pwr
      - materials
      - what_it_does
  - type: table
    name: By class
    rowHeight: medium
    filters:
      and:
        - type == "structures"
    order:
      - class
      - file.name
      - size
      - pwr
      - materials
      - what_it_does
    sort:
      - property: class
        direction: ASC
