views:
  - type: table
    name: All
    filters:
      and:
        - type == "hacking-gear"
    order:
      - file.name
      - modifier
      - cr
      - tier
      - notes
  - type: table
    name: By tier
    filters:
      and:
        - type == "hacking-gear"
    order:
      - tier
      - file.name
      - modifier
      - cr
      - notes
    sort:
      - property: tier
        direction: ASC
