views:
  - type: table
    name: All
    filters:
      and:
        - type == "weapon-characteristics"
    order:
      - file.name
      - cr
      - tier
      - effect
  - type: table
    name: By tier
    filters:
      and:
        - type == "weapon-characteristics"
    order:
      - tier
      - file.name
      - cr
      - effect
    sort:
      - property: tier
        direction: ASC
