views:
  - type: table
    name: All
    rowHeight: medium
    filters:
      and:
        - type == "terrain-verbs"
    order:
      - file.name
      - tag
      - stat
      - resolution
      - notes
  - type: table
    name: By stat
    rowHeight: medium
    filters:
      and:
        - type == "terrain-verbs"
    order:
      - stat
      - file.name
      - tag
      - resolution
      - notes
    sort:
      - property: stat
        direction: ASC
