views:
  - type: table
    name: All
    filters:
      and:
        - type == "traps"
    order:
      - file.name
      - build
      - credits
      - trigger_effect
  - type: table
    name: By build
    filters:
      and:
        - type == "traps"
    order:
      - build
      - file.name
      - credits
      - trigger_effect
    sort:
      - property: build
        direction: ASC
