views:
  - type: table
    name: All
    filters:
      and:
        - type == "armour"
    order:
      - file.name
      - injury
      - drawback
      - cr
      - tier
    rowHeight: medium
  - type: table
    name: By tier
    filters:
      and:
        - type == "armour"
    order:
      - tier
      - file.name
      - injury
      - drawback
      - cr
    sort:
      - property: tier
        direction: ASC
    rowHeight: medium
