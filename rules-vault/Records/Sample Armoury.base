views:
  - type: table
    name: All
    filters:
      and:
        - type == "sample-armoury"
    order:
      - file.name
      - build
      - profile
      - cr
  - type: table
    name: By build
    filters:
      and:
        - type == "sample-armoury"
    order:
      - build
      - file.name
      - profile
      - cr
    sort:
      - property: build
        direction: ASC
